FROM gcr.io/distroless/cc-debian12

ARG SERVICE_VERSION=dev

LABEL org.opencontainers.image.description="ZeepCentraal database migration runner for applying Drizzle schema migrations."

WORKDIR /app

COPY --chmod=755 dist/zeepcentraal-migrate zeepcentraal-migrate
COPY packages/database/drizzle drizzle

ENV NODE_ENV=production
ENV OPENTELEMETRY_SERVICE_NAME=zeepcentraal-migrate
ENV OPENTELEMETRY_SERVICE_VERSION=$SERVICE_VERSION
ENV MIGRATIONS_FOLDER=/app/drizzle

CMD ["./zeepcentraal-migrate"]
