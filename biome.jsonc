{
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"noDuplicateClasses": "on",
				"useSortedInterfaceMembers": "on"
			}
		}
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"linter": {
		"rules": {
			"suspicious": {},
			"complexity": {
				"useArrowFunction": "info"
			},
			"style": {
				"noParameterAssign": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!coverage",
			"!dist",
			"!zeepcentraal-web",
			"!packages/graphql/schema.graphql",
			"!packages/graphql/schema.local.graphql",
			"!packages/web/.data",
			"!packages/web/.nuxt",
			"!packages/web/.output",
			"!packages/graphql/src/generated",
			"!packages/web/public/assets/block-meshes",
			"!packages/web/test-results"
		]
	},
	"overrides": [
		{
			"includes": ["packages/web/**/*.vue"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useConst": "off",
						"useImportType": "off",
						"useVueMultiWordComponentNames": "off"
					}
				}
			}
		}
	]
}
