{
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"linter": {
		"rules": {
			"suspicious": {},
			"complexity": {
				"useArrowFunction": "info"
			},
			"style": {
				"noParameterAssign": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!packages/graphql/schema.graphql",
			"!packages/graphql/schema.local.graphql",
			"!packages/graphql/schema.v4.graphql",
			"!packages/graphql/schema.v5.graphql"
		]
	}
}
