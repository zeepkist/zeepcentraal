FROM gcr.io/distroless/cc-debian12

ARG SERVICE_VERSION=dev

LABEL org.opencontainers.image.description="ZeepCentraal API server."

WORKDIR /app

COPY --chmod=755 dist/zeepcentraal-server zeepcentraal-server

ENV NODE_ENV=production
ENV OPENTELEMETRY_SERVICE_NAME=zeepcentraal-server
ENV OPENTELEMETRY_SERVICE_VERSION=$SERVICE_VERSION

EXPOSE 3000 3001

CMD ["./zeepcentraal-server"]
