{
	"name": "@zeepkist/zeepcentraal",
	"private": true,
	"packageManager": "bun@1.3.14",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"preview:web": "bun --bun --cwd=packages/web run preview",
		"dev:server": "bun --watch packages/server/src/index.ts",
		"dev:jobs": "bun --watch packages/jobs/src/index.ts",
		"dev:postgraphile": "bun --watch packages/postgraphile/src/index.ts",
		"dev:web": "bun --bun --cwd=packages/web run dev",
		"graphql:smoke": "bun --cwd=packages/postgraphile run smoke:web",
		"jobs:trigger": "bun packages/server/scripts/jobs-trigger.ts",
		"build:server": "bun --cwd=packages/server run build",
		"build:jobs": "bun --cwd=packages/jobs run build",
		"build:migrate": "bun --cwd=packages/database run build",
		"build:import-zsl": "bun --cwd=packages/import-zsl run build",
		"build:postgraphile": "bun --cwd=packages/postgraphile run build",
		"build:web": "bun --bun --cwd=packages/web run build:deployment",
		"release:core": "bun --cwd=packages/core run release",
		"release:database": "bun --cwd=packages/database run release",
		"release:server": "bun --cwd=packages/server run release",
		"release:jobs": "bun --cwd=packages/jobs run release",
		"release:import-zsl": "bun --cwd=packages/import-zsl run release",
		"release:postgraphile": "bun --cwd=packages/postgraphile run release",
		"release:telemetry": "bun --cwd=packages/telemetry run release",
		"release:workshop": "bun --cwd=packages/workshop run release",
		"release:web": "bun --cwd=packages/web run release",
		"release": "bun run release:core && bun run release:database && bun run release:server && bun run release:jobs && bun run release:import-zsl && bun run release:postgraphile && bun run release:telemetry && bun run release:workshop && bun run release:web",
		"db:studio": "bun --bun --cwd=packages/database run dev",
		"db:generate": "bun --bun --cwd=packages/database run db:generate",
		"db:migrate": "bun --bun --cwd=packages/database run db:migrate",
		"db:seed:tournaments:local": "bun --cwd=packages/database run db:seed:tournaments:local",
		"db:migration:adventure-levels": "bun --bun --cwd=packages/database run db:migration:adventure-levels",
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"test": "bun test --isolate",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:staged": "lint-staged",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/github": "12.0.9",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@types/bun": "1.3.14",
		"better-sqlite3": "12.11.1",
		"conventional-changelog-conventionalcommits": "10.2.1",
		"husky": "9.1.7",
		"lint-staged": "17.0.8",
		"semantic-release": "25.0.7",
		"semantic-release-monorepo": "8.0.2",
		"typescript": "6.0.3"
	},
	"patchedDependencies": {
		"nuxt-bun-compile@0.1.32": "patches/nuxt-bun-compile@0.1.32.patch"
	}
}
