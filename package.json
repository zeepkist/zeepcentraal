{
	"name": "@zeepkist/zeepcentraal",
	"private": true,
	"packageManager": "bun@1.4.3",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"overrides": {
		"vue": "3.6.0-rc.11",
		"@vue/shared": "3.6.0-rc.11",
		"@vue/reactivity": "3.6.0-rc.11",
		"@vue/runtime-core": "3.6.0-rc.11",
		"@vue/runtime-dom": "3.6.0-rc.11",
		"@vue/runtime-vapor": "3.6.0-rc.11",
		"@vue/compiler-core": "3.6.0-rc.11",
		"@vue/compiler-dom": "3.6.0-rc.11",
		"@vue/compiler-sfc": "3.6.0-rc.11",
		"@vue/compiler-ssr": "3.6.0-rc.11",
		"@vue/compiler-vapor": "3.6.0-rc.11",
		"@vue/server-renderer": "3.6.0-rc.11"
	},
	"scripts": {
		"build:inspector-zeep": "bun --cwd=packages/inspector-zeep run build",
		"inspect:submissions": "bun packages/inspector-zeep/src/index.ts",
		"preview:web": "bun --bun --cwd=packages/web run preview",
		"dev:server": "cargo run --locked -p zc-server --bin zeepcentraal-server",
		"dev:jobs": "cargo run --locked -p zc-jobs --bin zeepcentraal-jobs",
		"dev:import-zsl": "cargo run --locked -p zc-import-zsl --bin zeepcentraal-import-zsl",
		"dev:lobby-host": "bun --watch packages/lobby-host/src/index.ts",
		"dev:postgraphile": "bun --watch packages/postgraphile/src/bootstrap.ts",
		"dev:discord": "bun --watch packages/discord/src/index.ts",
		"dev:streamkist": "cargo run --locked -p zc-streamkist",
		"dev:web": "bun --bun --cwd=packages/web run dev",
		"jobs:trigger": "bun packages/server/scripts/jobs-trigger.ts",
		"generate:block-meshes": "bun --cwd=packages/web run generate:block-meshes",
		"build:server": "cargo build --locked --release -p zc-server --bin zeepcentraal-server",
		"build:jobs": "cargo build --locked --release -p zc-jobs --bin zeepcentraal-jobs",
		"build:import-zsl": "cargo build --locked --release -p zc-import-zsl --bin zeepcentraal-import-zsl",
		"build:lobby-host": "bun --cwd=packages/lobby-host run build",
		"build:migrate": "cargo build --locked --release -p zc-migrate --bin zeepcentraal-migrate",
		"build:postgraphile": "bun --cwd=packages/postgraphile run build",
		"build:discord": "bun --cwd=packages/discord run build",
		"build:streamkist": "cargo build --locked --release -p zc-streamkist --bins",
		"build:web": "bun --bun --cwd=packages/web run build",
		"graphql:codegen": "bun --cwd=packages/graphql run codegen",
		"graphql:introspect": "bun --cwd=packages/graphql run introspect",
		"graphql:publish": "bun --cwd=packages/graphql run publish",
		"graphql:smoke": "bun --cwd=packages/postgraphile run smoke:web",
		"release": "semantic-release",
		"db:studio": "bun --bun --cwd=packages/database run dev",
		"db:migrate": "cargo run --locked -p zc-migrate --bin zeepcentraal-migrate -- adopt",
		"db:verify": "cargo run --locked -p zc-migrate --bin zeepcentraal-migrate -- verify",
		"db:inspect-history": "cargo run --locked -p zc-migrate --bin zeepcentraal-migrate -- inspect-history",
		"db:generate-adventure-environment": "cargo run --locked -p zc-migrate --bin zeepcentraal-migrate -- generate-adventure-environment",
		"prepare": "git config --local core.hooksPath .githooks || true",
		"typecheck": "golar",
		"typecheck:web": "bun --cwd=packages/web run typecheck",
		"test": "cargo test --locked --workspace",
		"test:bun": "bun test --isolate",
		"test:discord": "bun --cwd=packages/discord run test",
		"test:server:differential": "bun packages/server/scripts/differential-contract.ts",
		"test:web": "bun --cwd=packages/web run test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:staged": "lint-staged",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"skill:add": "skills add"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.5.7",
		"@clack/prompts": "~1.8.0",
		"@semantic-release/commit-analyzer": "~13.0.1",
		"@semantic-release/github": "~12.0.9",
		"@semantic-release/release-notes-generator": "~14.1.1",
		"@types/bun": "~1.4.0",
		"conventional-changelog-conventionalcommits": "~8.0.0",
		"golar": "~0.1.10",
		"lint-staged": "~17.6.0",
		"semantic-release": "~25.0.8",
		"skills": "~1.7.0",
		"typescript": "~7.0.2",
		"zod": "~4.6.0"
	}
}
