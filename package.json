{
	"name": "@zeepkist/zeepcentraal",
	"private": true,
	"packageManager": "bun@1.4.0",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"preview:web": "bun --bun --cwd=packages/web run preview",
		"dev:server": "bun --watch packages/server/src/bootstrap.ts",
		"dev:jobs": "bun --watch packages/jobs/src/index.ts",
		"dev:lobby-host": "bun --watch packages/lobby-host/src/index.ts",
		"dev:postgraphile": "bun --watch packages/postgraphile/src/bootstrap.ts",
		"dev:discord": "bun --watch packages/discord/src/index.ts",
		"dev:web": "bun --bun --cwd=packages/web run dev",
		"jobs:trigger": "bun packages/server/scripts/jobs-trigger.ts",
		"generate:block-meshes": "bun --cwd=packages/web run generate:block-meshes",
		"build:server": "bun --cwd=packages/server run build",
		"build:jobs": "bun --cwd=packages/jobs run build",
		"build:lobby-host": "bun --cwd=packages/lobby-host run build",
		"build:migrate": "bun --cwd=packages/database run build",
		"build:import-zsl": "bun --cwd=packages/import-zsl run build",
		"build:postgraphile": "bun --cwd=packages/postgraphile run build",
		"build:discord": "bun --cwd=packages/discord run build",
		"build:web": "bun --bun --cwd=packages/web run build",
		"graphql:codegen": "bun --cwd=packages/graphql run codegen",
		"graphql:introspect": "bun --cwd=packages/graphql run introspect",
		"graphql:publish": "bun --cwd=packages/graphql run publish",
		"graphql:smoke": "bun --cwd=packages/postgraphile run smoke:web",
		"release": "semantic-release",
		"db:studio": "bun --bun --cwd=packages/database run dev",
		"db:generate": "bun --bun --cwd=packages/database run db:generate",
		"db:migrate": "bun --bun --cwd=packages/database run db:migrate",
		"db:seed:tournaments:local": "bun --cwd=packages/database run db:seed:tournaments:local",
		"db:migration:adventure-levels": "bun --bun --cwd=packages/database run db:migration:adventure-levels",
		"prepare": "git config --local core.hooksPath .githooks || true",
		"typecheck": "golar",
		"typecheck:web": "bun --cwd=packages/web run typecheck",
		"test": "bun test --isolate",
		"test:discord": "bun --cwd=packages/discord run test",
		"test:web": "bun --cwd=packages/web run test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:staged": "lint-staged",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"skill:add": "skills add"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.5.7",
		"@semantic-release/commit-analyzer": "~13.0.1",
		"@semantic-release/github": "~12.0.9",
		"@semantic-release/release-notes-generator": "~14.1.1",
		"@types/bun": "~1.4.0",
		"conventional-changelog-conventionalcommits": "~10.4.0",
		"golar": "~0.1.10",
		"lint-staged": "~17.4.0",
		"semantic-release": "~25.0.8",
		"skills": "~1.5.21",
		"typescript": "~7.0.2"
	}
}
