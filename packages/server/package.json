{
	"name": "@zeepkist/server",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"scripts": {
		"jobs:trigger": "bun --env-file=../../.env scripts/jobs-trigger.ts",
		"build": "bun build --compile --minify --splitting --compile-exec-argv=\"--smol --user-agent=ZeepCentraal\" --outfile ../../dist/zeepcentraal-server src/index.ts --external @doctormckay/steam-crypto --external @napi-rs/lzma --external @napi-rs/lzma/lzma --external lzma --external xxhash-addon"
	},
	"dependencies": {
		"@elysiajs/cors": "~1.4.2",
		"@elysiajs/openapi": "~1.4.15",
		"@zeepkist/core": "workspace:*",
		"@zeepkist/database": "workspace:*",
		"@zeepkist/jobs": "workspace:*",
		"@zeepkist/telemetry": "workspace:*",
		"elysia": "~1.4.29",
		"logixlysia": "~6.6.0",
		"semver": "~7.8.5",
		"steam-user": "^5.3.0"
	},
	"devDependencies": {
		"@clack/prompts": "~1.7.0",
		"@types/semver": "~7.8.0",
		"@types/steam-user": "^5.1.1"
	}
}
