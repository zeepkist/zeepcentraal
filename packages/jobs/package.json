{
	"name": "@zeepkist/jobs",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"scripts": {
		"build": "bun build --compile --minify --splitting --compile-exec-argv=\"--smol --user-agent=ZeepCentraal\" --outfile ../../dist/zeepcentraal-jobs src/index.ts --external @napi-rs/lzma --external @napi-rs/lzma/lzma --external xxhash-addon"
	},
	"exports": {
		".": {
			"import": "./src/index.ts"
		},
		"./queue": {
			"import": "./src/queue.ts"
		},
		"./task-definitions": {
			"import": "./src/taskDefinitions.ts"
		}
	},
	"dependencies": {
		"@zeepkist/core": "workspace:*",
		"@zeepkist/database": "workspace:*",
		"@zeepkist/workshop": "workspace:*",
		"graphile-worker": "~0.17.3",
		"zod": "~4.4.3"
	}
}
