{
	"name": "@zeepkist/jobs",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"scripts": {
		"release": "semantic-release",
		"build": "bun build --compile --minify-whitespace --minify-syntax --outfile ../../dist/zeepcentraal-jobs src/index.ts --external @napi-rs/lzma --external @napi-rs/lzma/lzma --external xxhash-addon"
	},
	"exports": {
		".": {
			"import": "./src/index.ts"
		},
		"./queue": {
			"import": "./src/queue.ts"
		},
		"./task-definitions": {
			"import": "./src/taskDefinitions.ts"
		}
	},
	"dependencies": {
		"@keyv/postgres": "6.0.0-beta.4",
		"@zeepkist/core": "workspace:*",
		"@zeepkist/database": "workspace:*",
		"@zeepkist/workshop": "workspace:*",
		"cron": "4.4.0",
		"graphile-worker": "0.17.3",
		"keyv": "6.0.0-beta.4",
		"zod": "4.4.3"
	}
}
