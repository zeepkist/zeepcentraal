{
	"name": "@zeepkist/database",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"scripts": {
		"build": "bun build --compile --minify-whitespace --minify-syntax --outfile ../../dist/zeepcentraal-migrate src/migrate.ts",
		"dev": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed:tournaments:local": "bun --env-file ../../.env src/scripts/seedLocalTrackTournaments.ts",
		"db:migration:adventure-levels": "bun src/scripts/createAdventureLevelMigration.ts",
		"db:verify-graphql-visibility": "bun src/scripts/verifyGraphqlVisibility.ts"
	},
	"exports": {
		".": {
			"import": "./src/index.ts"
		},
		"./services": {
			"import": "./src/services/index.ts"
		},
		"./services/personalBest": {
			"import": "./src/services/personalBest.ts"
		},
		"./services/workshop": {
			"import": "./src/services/workshop.ts"
		}
	},
	"dependencies": {
		"@zeepkist/core": "workspace:*",
		"@zeepkist/telemetry": "workspace:*",
		"drizzle-orm": "~0.45.0",
		"postgres": "~3.4.7",
		"semver": "~7.8.0",
		"ulid": "~3.0.2"
	},
	"devDependencies": {
		"@types/semver": "~7.8.0",
		"drizzle-kit": "~0.31.5"
	}
}
