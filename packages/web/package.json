{
	"name": "@zeepkist/web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"release": "semantic-release",
		"build": "bun run prepare:nuxt && bun --bun nuxt build",
		"build:deployment": "rm -f ../../dist/zeepcentraal-web && bun run prepare:nuxt && NUXT_BUN_COMPILE=true bun --bun nuxt build && test -x ../../dist/zeepcentraal-web",
		"dev": "bun --bun nuxt dev --dotenv ../../.env",
		"preview": "bun --bun nuxt preview --dotenv ../../.env",
		"postinstall": "bun run prepare:nuxt",
		"prepare:nuxt": "bun --bun nuxt prepare",
		"codegen": "bun --bun graphql-codegen --config codegen.ts",
		"typecheck": "bun --bun node_modules/.bin/vue-tsc --noEmit -p tsconfig.json",
		"test": "bun --bun vitest run",
		"test:e2e": "bun --bun playwright test"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "3.2.0",
		"@nuxt/content": "3.15.0",
		"@nuxt/image": "2.0.0",
		"@nuxt/ui": "4.9.0",
		"@nuxtjs/i18n": "10.4.1",
		"@nuxtjs/seo": "5.3.2",
		"@pinia/nuxt": "~0.11.0",
		"@rollup/plugin-graphql": "3.0.0",
		"@tabler/icons-vue": "3.44.0",
		"@takumi-rs/core": "^2.0.0-rc.16",
		"@urql/vue": "2.1.1",
		"@vee-validate/zod": "4.15.1",
		"@zeepkist/core": "workspace:*",
		"@zeepkist/database": "workspace:*",
		"graphql": "17.0.2",
		"graphql-ws": "6.1.0",
		"nuxt": "4.4.8",
		"nuxt-charts": "2.1.4",
		"pinia": "~3.0.0",
		"sanitize-html": "2.17.6",
		"tailwindcss": "4.3.2",
		"vee-validate": "4.15.1",
		"vue": "3.5.39",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "7.2.0",
		"@graphql-codegen/client-preset": "6.1.0",
		"@iconify-json/lucide": "~1.2.117",
		"@playwright/test": "1.61.1",
		"@types/sanitize-html": "2.16.1",
		"@vue/test-utils": "2.4.11",
		"nuxt-bun-compile": "0.1.32",
		"vitest": "4.1.10",
		"vue-tsc": "3.3.7"
	}
}
