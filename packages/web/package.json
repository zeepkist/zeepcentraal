{
	"name": "@zeepkist/web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun --bun nuxt build",
		"build:deployment": "bun --bun run build && bun --bun install --cwd .output/server --production --ignore-scripts && bun --bun build --compile --target=bun-linux-x64-baseline --minify --sourcemap .output/server/index.mjs --outfile ../../dist/zeepcentraal-web",
		"dev": "bun --bun nuxt dev",
		"preview": "bun --bun nuxt preview",
		"postinstall": "bun --bun nuxt prepare",
		"codegen": "bun --bun graphql-codegen --config codegen.ts",
		"typecheck": "bun --bun node_modules/.bin/vue-tsc --noEmit -p tsconfig.json",
		"test": "bun --bun vitest run",
		"test:e2e": "bun --bun playwright test"
	},
	"dependencies": {
		"@nuxt/content": "~3.11.2",
		"@nuxt/image": "~2.0.0",
		"@nuxt/ui": "^4.0.0",
		"@nuxtjs/color-mode": "~4.0.1",
		"@nuxtjs/i18n": "~10.2.4",
		"@nuxtjs/seo": "~3.4.0",
		"@nuxtjs/sitemap": "^8.0.0",
		"@pinia/nuxt": "^0.11.3",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@rollup/plugin-graphql": "^2.0.5",
		"@tabler/icons-vue": "~3.44.0",
		"@tailwindcss/vite": "~4.3.1",
		"@urql/vue": "^2.0.0",
		"@vee-validate/zod": "^4.15.1",
		"better-sqlite3": "^12.4.1",
		"graphql": "~16.12.0",
		"graphql-ws": "~6.0.8",
		"nuxt": "~4.4.8",
		"nuxt-charts": "~0.2.4",
		"pinia": "^3.0.4",
		"tailwindcss": "~4.3.1",
		"vee-validate": "^4.15.1",
		"vue": "~3.5.38",
		"zod": "~4.4.0"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^6.0.2",
		"@graphql-codegen/client-preset": "^5.2.1",
		"@playwright/test": "^1.57.0",
		"@types/bun": "~1.3.2",
		"@vue/test-utils": "^2.4.6",
		"vitest": "^4.0.15",
		"vue-tsc": "^3.1.6"
	}
}
