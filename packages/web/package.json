{
	"name": "@zeepkist/web",
	"private": true,
	"type": "module",
	"imports": {
		"#shared/authCookies": "./shared/authCookies.ts"
	},
	"scripts": {
		"build": "bun run prepare:nuxt && bun --bun nuxt build && bun scripts/build-telemetry-bootstrap.ts",
		"dev": "bun --bun nuxt dev --dotenv ../../.env",
		"preview": "bun --bun --env-file ../../.env .output/server/telemetry.mjs",
		"postinstall": "bun run prepare:nuxt",
		"prepare:nuxt": "bun --bun nuxt prepare",
		"generate:block-meshes": "bun scripts/generate-block-mesh-manifest.ts",
		"codegen": "bun --cwd=../graphql run codegen",
		"typecheck": "nuxt typecheck",
		"test": "bun --bun vitest run --silent=passed-only",
		"test:e2e": "bun --bun playwright test"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "~3.2.0",
		"@nuxt/content": "~3.15.0",
		"@nuxt/image": "~2.1.0",
		"@nuxt/ui": "~4.10.0",
		"@nuxtjs/i18n": "~10.6.0",
		"@nuxtjs/seo": "~5.3.6",
		"@pinia/nuxt": "~1.0.0",
		"@tabler/icons-vue": "~3.46.0",
		"@takumi-rs/core": "~2.5.0",
		"@unhead/vue": "~3.3.0",
		"@urql/vue": "~2.1.1",
		"@vue/devtools-api": "~8.2.0",
		"@vueuse/core": "~14.4.0",
		"@vueuse/integrations": "~14.4.0",
		"@zeepkist/core": "workspace:*",
		"@zeepkist/database": "workspace:*",
		"@zeepkist/graphql": "workspace:*",
		"@zeepkist/telemetry": "workspace:*",
		"graphql": "~17.0.2",
		"graphql-ws": "~6.2.0",
		"lzma-wasm": "~1.0.7",
		"meshoptimizer": "~1.2.0",
		"nuxt": "~4.5.0",
		"nuxt-charts": "~2.2.0",
		"nuxt-og-image": "~6.7.5",
		"pinia": "~4.0.0",
		"sanitize-html": "~2.17.6",
		"sortablejs": "~1.15.6",
		"tailwindcss": "~4.3.3",
		"three": "~0.185.1",
		"vue": "~3.5.40",
		"vue-router": "~5.3.0",
		"zod": "~4.4.3"
	},
	"devDependencies": {
		"@golar/vue": "~0.1.10",
		"@iconify-json/tabler": "~1.2.38",
		"@playwright/test": "~1.62.0",
		"@types/sanitize-html": "~2.16.1",
		"@types/sortablejs": "~1.15.9",
		"@types/three": "~0.185.1",
		"@vue/test-utils": "~2.4.11",
		"fake-indexeddb": "~6.2.4",
		"unstorage": "~1.17.5",
		"vitest": "~4.1.10"
	}
}
