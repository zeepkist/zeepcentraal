{
	"name": "@zeepkist/web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"release": "semantic-release",
		"build": "bun --bun nuxt build",
		"build:deployment": "bun --bun run build && bun --bun install --cwd .output/server --production --ignore-scripts && bun --bun build --compile --target=bun-linux-x64-baseline --conditions=production --external 'chromium-bidi/*' --minify --sourcemap .output/server/index.mjs --outfile ../../dist/zeepcentraal-web",
		"dev": "bun --bun nuxt dev --dotenv ../../.env",
		"preview": "bun --bun nuxt preview --dotenv ../../.env",
		"postinstall": "bun --bun nuxt prepare",
		"codegen": "bun --bun graphql-codegen --config codegen.ts",
		"typecheck": "bun --bun node_modules/.bin/vue-tsc --noEmit -p tsconfig.json",
		"test": "bun --bun vitest run",
		"test:e2e": "bun --bun playwright test"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "~3.2.0",
		"@nuxt/content": "~3.15.0",
		"@nuxt/image": "~2.0.0",
		"@nuxt/ui": "~4.9.0",
		"@nuxtjs/i18n": "~10.4.0",
		"@nuxtjs/seo": "~5.3.0",
		"@pinia/nuxt": "~0.11.0",
		"@rollup/plugin-graphql": "~3.0.0",
		"@tabler/icons-vue": "~3.44.0",
		"@urql/vue": "~2.1.0",
		"@vee-validate/zod": "~4.15.0",
		"@zeepkist/core": "workspace:*",
		"@zeepkist/database": "workspace:*",
		"graphql": "~17.0.0",
		"graphql-ws": "~6.1.0",
		"nuxt": "~4.4.0",
		"nuxt-charts": "~2.1.0",
		"pinia": "~3.0.0",
		"sanitize-html": "^2.17.6",
		"tailwindcss": "~4.3.0",
		"vee-validate": "~4.15.0",
		"vue": "~3.5.0",
		"zod": "~4.4.0"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "~7.2.0",
		"@graphql-codegen/client-preset": "~6.1.0",
		"@iconify-json/lucide": "~1.2.116",
		"@playwright/test": "~1.61.0",
		"@types/bun": "~1.3.0",
		"@types/sanitize-html": "^2.16.1",
		"@vue/test-utils": "~2.4.0",
		"vitest": "~4.1.0",
		"vue-tsc": "~3.3.0"
	}
}
