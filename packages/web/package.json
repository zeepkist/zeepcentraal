{
	"name": "@zeepkist/web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"release": "semantic-release",
		"build": "bun run prepare:nuxt && bun --bun nuxt build",
		"build:deployment": "rm -f ../../dist/zeepcentraal-web && bun run prepare:nuxt && NUXT_BUN_COMPILE=true bun --bun nuxt build && bun run stage:takumi-addon && test -x ../../dist/zeepcentraal-web",
		"dev": "bun --bun nuxt dev --dotenv ../../.env",
		"preview": "bun --bun nuxt preview --dotenv ../../.env",
		"postinstall": "bun run prepare:nuxt",
		"prepare:nuxt": "bun --bun nuxt prepare",
		"stage:takumi-addon": "bun scripts/stage-takumi-native-addon.ts",
		"codegen": "bun --bun graphql-codegen --config codegen.ts",
		"typecheck": "nuxt typecheck",
		"test": "bun --bun vitest run",
		"test:e2e": "bun --bun playwright test"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "3.2.0",
		"@nuxt/content": "3.15.0",
		"@nuxt/image": "2.0.0",
		"@nuxt/ui": "4.9.0",
		"@nuxtjs/i18n": "10.4.1",
		"@nuxtjs/seo": "5.3.2",
		"@pinia/nuxt": "~0.11.0",
		"@rollup/plugin-graphql": "3.0.0",
		"@tabler/icons-vue": "3.44.0",
		"@takumi-rs/core": "2.4.0",
		"@urql/vue": "2.1.1",
		"@vee-validate/zod": "4.15.1",
		"@zeepkist/core": "workspace:*",
		"@zeepkist/database": "workspace:*",
		"graphql": "17.0.2",
		"graphql-ws": "6.1.0",
		"lzma-wasm": "^1.0.7",
		"nuxt": "^4.5.0",
		"nuxt-charts": "2.1.4",
		"pinia": "~3.0.0",
		"sanitize-html": "2.17.6",
		"tailwindcss": "4.3.2",
		"three": "^0.185.1",
		"vee-validate": "4.15.1",
		"vue": "3.5.39",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@golar/vue": "0.1.10",
		"@graphql-codegen/cli": "7.2.0",
		"@graphql-codegen/client-preset": "6.1.0",
		"@iconify-json/lucide": "~1.2.117",
		"@playwright/test": "1.61.1",
		"@types/sanitize-html": "2.16.1",
		"@types/three": "^0.185.1",
		"@vue/test-utils": "2.4.11",
		"nuxt-bun-compile": "0.1.32",
		"vitest": "4.1.10"
	}
}
