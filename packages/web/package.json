{
	"name": "@zeepkist/web",
	"private": true,
	"type": "module",
	"imports": {
		"#shared/authCookies": "./shared/authCookies.ts"
	},
	"scripts": {
		"build": "bun run prepare:nuxt && bun --bun nuxt build",
		"dev": "bun --bun nuxt dev --dotenv ../../.env",
		"preview": "bun --bun nuxt preview --dotenv ../../.env",
		"postinstall": "bun run prepare:nuxt",
		"prepare:nuxt": "bun --bun nuxt prepare",
		"generate:block-meshes": "bun scripts/generate-block-mesh-manifest.ts",
		"codegen": "bun --bun graphql-codegen --config codegen.ts",
		"typecheck": "nuxt typecheck",
		"test": "bun --bun vitest run",
		"test:e2e": "bun --bun playwright test"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "~3.2.0",
		"@nuxt/content": "~3.15.0",
		"@nuxt/image": "~2.0.0",
		"@nuxt/ui": "~4.10.0",
		"@nuxtjs/i18n": "~10.5.0",
		"@nuxtjs/seo": "~5.3.6",
		"@pinia/nuxt": "~1.0.0",
		"@rollup/plugin-graphql": "~3.0.0",
		"@tabler/icons-vue": "~3.45.0",
		"@takumi-rs/core": "~2.4.0",
		"@unhead/vue": "~3.2.3",
		"@urql/vue": "~2.1.1",
		"@vue/devtools-api": "~8.1.5",
		"@vueuse/core": "~14.3.0",
		"@zeepkist/core": "workspace:*",
		"@zeepkist/database": "workspace:*",
		"better-sqlite3": "~13.0.0",
		"graphql": "~17.0.2",
		"graphql-ws": "~6.2.0",
		"lzma-wasm": "~1.0.7",
		"meshoptimizer": "~1.1.1",
		"nuxt": "~4.5.0",
		"nuxt-charts": "~2.1.4",
		"pinia": "~4.0.0",
		"sanitize-html": "~2.17.6",
		"tailwindcss": "~4.3.3",
		"three": "~0.185.1",
		"vue": "~3.5.40",
		"vue-router": "~5.2.0",
		"zod": "~4.4.3"
	},
	"devDependencies": {
		"@golar/vue": "~0.1.10",
		"@graphql-codegen/cli": "~7.2.0",
		"@graphql-codegen/client-preset": "~6.1.0",
		"@iconify-json/lucide": "~1.2.118",
		"@playwright/test": "~1.61.1",
		"@types/sanitize-html": "~2.16.1",
		"@types/three": "~0.185.1",
		"@vue/test-utils": "~2.4.11",
		"vitest": "~4.1.10"
	}
}
