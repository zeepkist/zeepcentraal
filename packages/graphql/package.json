{
	"name": "@zeepkist/graphql",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts"
		},
		"./generated": {
			"import": "./src/generated/graphql.ts"
		}
	},
	"scripts": {
		"codegen": "bun --bun graphql-codegen --config codegen.ts",
		"introspect": "bun run --bun graphql-inspector introspect https://graphql.zeepki.st --write schema.graphql",
		"introspect:local": "bun run --bun graphql-inspector introspect http://localhost:5000 --write schema.graphql",
		"publish": "bun scripts/publish.ts"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "~3.2.0",
		"graphql": "~17.0.2"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "~7.4.0",
		"@graphql-codegen/client-preset": "~6.1.0",
		"@graphql-hive/cli": "~0.63.0",
		"@graphql-inspector/cli": "~7.0.0"
	}
}
