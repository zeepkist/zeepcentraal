# Shared
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zeepkist
KEYV_SCHEMA=zeepkist_cache

# API server
HOST=0.0.0.0
PORT=3000
TRIGGER_JOB_TOKEN=replace-me
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_RECORD_PER_MINUTE=120
RATE_LIMIT_MUTATION_PER_MINUTE=300
RATE_LIMIT_JOB_PER_MINUTE=60

# Auth
JWT_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Wasabi S3
WASABI_ACCESSKEY=
WASABI_SECRETKEY=
WASABI_BUCKET=
WASABI_ENDPOINT=
WASABI_REGION=
GHOST_FOLDER=ghosts-dev

# Integrations
STEAM_APP_ID=1440670
STEAM_API_KEY=
STEAMCMD_PATH=steamcmd
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# OpenTelemetry
OPENTELEMETRY_COLLECTOR_URL=http://localhost:4317
OPENTELEMETRY_SERVICE_NAME=
OPENTELEMETRY_SERVICE_VERSION=dev

# PostGraphile
POSTGRAPHILE_HOST=0.0.0.0
POSTGRAPHILE_PORT=5000
POSTGRAPHILE_REQUEST_LOGGING=false
GRAPHQL_FIELD_TRACING=false
GRAPHQL_QUERY_TRACE_DETAIL=false
GRAPHQL_MAX_QUERY_COST=5000
GRAPHQL_DEFAULT_COLLECTION_SIZE=100
POSTGRAPHILE_LIVE_QUERIES=true
POSTGRAPHILE_LIVE_QUERY_POLL_MS=250
POSTGRAPHILE_LIVE_QUERY_DEBOUNCE_MS=100
POSTGRAPHILE_LIVE_QUERY_MAX_OPERATIONS=1000
POSTGRAPHILE_LIVE_QUERY_INVALIDATION_RETENTION_MINUTES=60
CDN_BASE_URL=https://cdn.zeepki.st
GRAPHILE_TURBO=1

# Web
NUXT_PUBLIC_GRAPHQL_HTTP_URL=https://graphql.zeepki.st
NUXT_PUBLIC_GRAPHQL_WS_URL=wss://graphql.zeepki.st
NUXT_PUBLIC_BACKEND_URL=https://backend.zeepki.st
# Local web GraphQL overrides:
# NUXT_PUBLIC_GRAPHQL_HTTP_URL=http://localhost:5000
# NUXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:5000
