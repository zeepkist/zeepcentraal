+++ b/dist/findPackageJSON.mjs
@@ -0,0 +1,30 @@
+import * as module from 'node:module';
+import { existsSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// Bun 1.4 does not export Node's findPackageJSON yet.
+export const findPackageJSON = module.findPackageJSON ?? ((specifier, base) => {
+  const baseDirectory = base ? dirname(fileURLToPath(base)) : process.cwd();
+  let directory = baseDirectory;
+  if (specifier instanceof URL || String(specifier).startsWith('file:')) {
+    directory = dirname(fileURLToPath(specifier));
+  } else if (specifier !== './') {
+    try {
+      directory = dirname(Bun.resolveSync(specifier, baseDirectory));
+    } catch (error) {
+      if (error?.code === 'MODULE_NOT_FOUND')
+        error.code = 'ERR_MODULE_NOT_FOUND';
+      throw error;
+    }
+  }
+  for (;;) {
+    const manifest = join(directory, 'package.json');
+    if (existsSync(manifest))
+      return manifest;
+    const parent = dirname(directory);
+    if (parent === directory)
+      return undefined;
+    directory = parent;
+  }
+});
