# Takumi's native renderer requires libgcc_s.so.1, which Bun's distroless image omits.
FROM oven/bun:1.4.2-slim

ARG SERVICE_VERSION=dev

LABEL org.opencontainers.image.description="ZeepCentraal Nuxt web application."

WORKDIR /app

COPY --chown=65532:65532 packages/web/.output .output

ENV NODE_ENV=production
ENV NITRO_PORT=4000
ENV OPENTELEMETRY_SERVICE_NAME=zeepcentraal-web
ENV OPENTELEMETRY_SERVICE_VERSION=$SERVICE_VERSION

EXPOSE 4000

USER 65532:65532

ENTRYPOINT ["bun", "--bun", ".output/server/telemetry.mjs"]
